%% ByteBites -- verified class design
%% Source: bytebites_spec.md, bounded by ByteBites_Design_Reference.md
classDiagram
    class Customer {
        +String name
        +list~Order~ purchase_history
        +record_purchase(order) void
        +is_returning_customer() bool
    }
    class MenuItem {
        +String name
        +float price
        +String category
        +float popularity
    }
    class Menu {
        +list~MenuItem~ items
        +add_item(item) void
        +filter_by_category(category) list~MenuItem~
        +sort_by_popularity() list~MenuItem~
    }
    class Order {
        +Customer customer
        +list~MenuItem~ items
        +add_item(item) void
        +calculate_total() float
    }
    Menu "1" --> "*" MenuItem : holds
    Order "1" --> "*" MenuItem : contains
    Order "1" --> "1" Customer : placed by
    Customer "1" --> "*" Order : purchase_history
